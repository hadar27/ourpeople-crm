# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Settings → API Keys in the Supabase dashboard.
# Use the "publishable" key (sb_publishable_...) — NOT the "secret" key, which
# must never be exposed to the browser. Legacy "anon"/"service_role" JWT keys
# also still work here if that's what your project shows, but Supabase is
# deprecating them in favor of publishable/secret keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
